<?xml version="1.0" encoding="utf-8"?>
<!--
  压缩对话框：文件路径、格式与压缩级别、压缩选项。
  行为（默认文件名、格式联动、分离打包）在 DlgCompress 里。
-->
<LinearLayout orientation="vertical" padding="16" background="dialogBg">

  <TextView text="压缩文件名(F)" height="18" textColor="textHead"/>

  <LinearLayout orientation="horizontal" height="30" marginY="4">
    <InputBox id="path" weight="1" height="30" padding="8"/>
    <Button id="btnBrowse" text="浏览(B)..." style="outline" width="92" height="30" marginX="8"/>
  </LinearLayout>

  <TextView text="压缩文件格式" height="18" marginY="4" textColor="textHead"/>

  <!-- 格式一行：ZIP / 7Z / 其他（第三个单选无文字，由右侧下拉框承载） -->
  <LinearLayout orientation="horizontal" height="30" alignY="center">
    <RadioGroup id="formatGroup" width="wrap" height="24" orientation="horizontal" rowGap="14">
      <RadioButton id="fmtZip">ZIP</RadioButton>
      <RadioButton id="fmt7z">7Z</RadioButton>
      <RadioButton id="fmtOther"></RadioButton>
    </RadioGroup>
    <ComboBox id="otherFormat" width="180" height="30" marginX="4"/>
  </LinearLayout>

  <!-- 左栏：压缩级别 / 更新方式 / 分卷；右栏：压缩选项 -->
  <LinearLayout orientation="horizontal" marginY="8">

    <LinearLayout orientation="vertical" width="240">
      <TextView text="压缩级别(C)" height="18" textColor="textHead"/>
      <ComboBox id="level" height="30" marginY="4"/>

      <TextView text="更新方式(U)" height="18" marginY="4" textColor="textHead"/>
      <ComboBox id="updateMode" height="30" marginY="4"/>

      <TextView text="压缩分卷大小设置(V)" height="18" marginY="4" textColor="textHead"/>
      <LinearLayout orientation="horizontal" height="30">
        <InputBox id="volume" weight="1" height="30" padding="8"/>
        <ComboBox id="volumeUnit" width="72" height="30" marginX="6"/>
      </LinearLayout>
    </LinearLayout>

    <GroupBox title="压缩选项" weight="1" marginX="12">
      <LinearLayout orientation="vertical">
        <CheckBox id="optSolid">创建固实压缩文件(S)(仅 7Z)</CheckBox>
        <CheckBox id="optTest" marginY="8">压缩后测试压缩文件(E)</CheckBox>
        <CheckBox id="optDelete" marginY="8">压缩后删除源文件(L)</CheckBox>
        <CheckBox id="optSeparate" marginY="8">压缩每个选中项到单独的压缩文件</CheckBox>
        <Button id="btnPassword" text="设置密码(P)..." style="outline" width="120" height="28"
                marginY="8"/>
      </LinearLayout>
    </GroupBox>

  </LinearLayout>

  <!-- 底部：左「恢复默认」，右「确定 / 取消」 -->
  <LinearLayout orientation="horizontal" height="32" marginY="6">
    <Button id="btnDefault" text="恢复默认(D)" style="outline" width="116" height="30"/>
    <View weight="1"/>
    <Button id="btnOk" text="确定" width="80" height="30"/>
    <Button id="btnCancel" text="取消" style="outline" width="80" height="30" marginX="8"/>
  </LinearLayout>

</LinearLayout>
