<?xml version="1.0" encoding="utf-8"?>
<!--
  进度窗口：整个窗口就是一条大进度条。

  没有标题栏。底层 ProgressBar 撑满整个客户区当轨道与填充，文字与关闭按钮
  叠在它上面。轨道与填充都是极浅的蓝，靠深藏青标题拉开对比（见 onCreate）。
  根节点 dragWindow 在 onCreate 里打开，整条都能拖动；关闭按钮自己声明
  要鼠标事件，命中测试会把它留成客户区。
-->
<FrameLayout>

  <!-- 铺满整窗的进度条。轨道与填充色都在 onCreate 里按参考配色设 -->
  <ProgressBar id="bar" width="match" height="match" barHeight="176" radius="0"/>

  <!-- 叠在进度条上的内容：左侧文字撑满余量，右侧关闭按钮 -->
  <LinearLayout orientation="horizontal" width="match" height="match" paddingLeft="34">

    <LinearLayout orientation="vertical" weight="1" height="wrap" alignY="center"
                  paddingRight="12">
      <!-- 主行：动作 + 文件名，超大加粗深藏青 -->
      <TextView id="file" width="match" height="46" bold="true" huge="true"/>
      <!-- 副行：百分比与大小，放大一档的灰蓝 -->
      <TextView id="detail" width="match" height="34" marginTop="8" large="true"/>
    </LinearLayout>

    <!-- 关闭：幽灵样式，只改图标颜色、不铺背景 -->
    <Button id="btnCancel" icon="close" iconPlacement="only" style="ghost"
            width="58" height="52" iconSize="16" radius="0" padX="0" alignY="start"/>
  </LinearLayout>

</FrameLayout>
