<?xml version="1.0" encoding="utf-8"?>
<!--
  解压对话框：只保留目标路径。更新方式、覆盖方式、其他选项已移除，
  密码在识别到加密时才单独询问，因此这里的控件装配很薄。

  内容高度约 116（160 DPI 设计值），窗口按 164 开，多出的余量由
  按钮行上方的弹性空白吸收，按钮永远贴着底部而不是被挤出客户区。
-->
<LinearLayout orientation="vertical" padding="16" background="dialogBg">

  <TextView text="目标路径(T)" height="18" textColor="textHead"/>

  <!-- 路径输入 + 右侧浏览按钮 -->
  <LinearLayout orientation="horizontal" height="30" marginY="4">
    <InputBox id="target" weight="1" height="30" padding="8"/>
    <Button id="btnBrowse" text="浏览(B)..." style="outline" width="96" height="30" marginX="8"/>
  </LinearLayout>

  <!-- 弹性空白：多余高度留在这里，按钮贴底 -->
  <View weight="1"/>

  <!-- 底部：右「确定 / 取消」 -->
  <LinearLayout orientation="horizontal" height="32" marginY="10">
    <View weight="1"/>
    <Button id="btnOk" text="确定" style="primary" width="84" height="32"/>
    <Button id="btnCancel" text="取消" style="outline" width="84" height="32" marginX="8"/>
  </LinearLayout>

</LinearLayout>
