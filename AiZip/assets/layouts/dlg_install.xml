<?xml version="1.0" encoding="utf-8"?>
<!--
  安装程序主界面：选安装范围 → 选目录 → 安装。

  按钮固定在底部，目录行占满剩余宽度，窗口拉高时只有中间弹簧伸缩，
  底部按钮永远可见（避免高 DPI 或小屏下被裁掉）。
-->
<LinearLayout orientation="vertical" paddingLeft="12" paddingRight="18" paddingTop="18"
              paddingBottom="18" spacing="10" background="dialogBg">

  <!-- 标题与说明 -->
  <TextView text="安装爱压" height="26" textColor="text" bold="true"/>
  <TextView text="选择安装范围，再把程序放到目标目录并挂上资源管理器右键菜单。"
            height="20" textColor="textMuted"/>

  <!-- 安装范围 -->
  <LinearLayout orientation="horizontal" height="30" alignY="center" marginTop="8">
    <TextView text="安装范围" width="wrap" height="30" align="right" textColor="textMuted"/>
    <RadioGroup id="scopeGroup" width="wrap" height="30" orientation="horizontal"
                rowGap="18" marginLeft="10">
      <RadioButton id="scopeUser">仅当前用户</RadioButton>
      <RadioButton id="scopeAll">所有用户</RadioButton>
    </RadioGroup>
  </LinearLayout>

  <!-- 目标目录 -->
  <LinearLayout orientation="horizontal" height="30">
    <TextView text="安装目录" width="wrap" height="30" align="right" textColor="textMuted"/>
    <InputBox id="dir" weight="1" height="30" padding="8" marginLeft="10" marginRight="10"/>
    <Button id="btnBrowse" text="浏览..." style="outline" width="76" height="30"/>
  </LinearLayout>

  <!-- 权限提示：只在「所有用户」且未提权时显示 -->
  <TextView id="elevateHint" text="所有用户需要管理员权限，点击「安装」时系统会提示提权。"
            height="20" textColor="textMuted"/>

  <!-- 弹簧：把按钮行顶到底部 -->
  <View weight="1" height="1"/>

  <LinearLayout orientation="horizontal" height="32" marginY="12">
    <View weight="1"/>
    <Button id="btnInstall" text="安装" style="primary" width="84" height="32"/>
    <Button id="btnCancel" text="取消" style="outline" width="84" height="32" marginLeft="10"/>
  </LinearLayout>

</LinearLayout>
