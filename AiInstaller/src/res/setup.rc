#pragma code_page(65001)
#include <windows.h>

// 通用安装器的默认图标。打包器会用应用自己的图标覆盖它，
// 所以这里只需要一个能看的占位。
1 ICON "aicon.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION 1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "AISoft"
      VALUE "FileDescription", "通用安装程序"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "AiSetup"
      VALUE "OriginalFilename", "AiSetup.exe"
      VALUE "ProductName", "AiSetup"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
