<?xml version="1.0" encoding="utf-8"?>
<!--
  通用安装界面：结构固定，所有文字与图标都由安装包清单提供。

  为什么不给每个应用一份布局：AiUI 的布局在构建期编译成 C++，运行时换
  XML 等于要给安装器塞一个解析器。而安装界面本来就该长一个样——用户
  认得的是流程，不是像素。所以模板只此一份，应用改的是清单里的文案。

  三段式：配置页 → 进度页 → 完成页。三页叠在同一个窗口里，用可见性切换，
  不给每一步各开一个窗口——窗口会闪、会跳位置，用户看到的本来就是同一个任务。
  底部按钮行常驻，每页只换按钮内容。
-->
<LinearLayout orientation="vertical" paddingLeft="16" paddingRight="20" paddingTop="16"
              paddingBottom="16" spacing="10" background="dialogBg">

  <!-- 头部：三页共用，图标 + 标题 + 说明始终可见，视觉上是同一个程序 -->
  <LinearLayout orientation="horizontal" height="52" alignY="center">
    <ImageView id="logo" width="48" height="48" scale="fit"/>
    <LinearLayout orientation="vertical" weight="1" marginLeft="14" alignY="center">
      <TextView id="title" height="24" textColor="text" bold="true"/>
      <TextView id="description" height="20" textColor="textMuted" marginTop="2"/>
    </LinearLayout>
  </LinearLayout>

  <!-- ===== 第一页：配置 ===== -->
  <LinearLayout id="configPage" orientation="vertical" weight="1" spacing="10">

    <!-- 安装范围：清单里 showScope=0 时整行隐藏 -->
    <LinearLayout id="scopeRow" orientation="horizontal" height="30" alignY="center" marginTop="6">
      <TextView id="scopeLabel" text="安装范围" width="64" height="30" align="right"
                textColor="textMuted"/>
      <RadioGroup id="scopeGroup" width="wrap" height="30" orientation="horizontal"
                  rowGap="18" marginLeft="10">
        <RadioButton id="scopeUser">仅当前用户</RadioButton>
        <RadioButton id="scopeAll">所有用户</RadioButton>
      </RadioGroup>
    </LinearLayout>

    <!-- 目标目录 -->
    <LinearLayout orientation="horizontal" height="30">
      <TextView id="dirLabel" text="安装目录" width="64" height="30" align="right"
                textColor="textMuted"/>
      <InputBox id="dir" weight="1" height="30" padding="8" marginLeft="10" marginRight="10"/>
      <Button id="btnBrowse" text="浏览..." style="outline" width="76" height="30"/>
    </LinearLayout>

    <!-- 权限提示：只在「所有用户」且未提权时显示 -->
    <TextView id="hint" height="20" textColor="textMuted"/>

    <!-- 弹簧：把按钮行顶到底部 -->
    <View weight="1" height="1"/>

    <LinearLayout orientation="horizontal" height="32" marginTop="6">
      <View weight="1"/>
      <Button id="btnInstall" text="安装" style="primary" width="88" height="32"/>
      <Button id="btnCancel" text="取消" style="outline" width="88" height="32" marginLeft="10"/>
    </LinearLayout>
  </LinearLayout>

  <!-- ===== 第二页：进度 ===== -->
  <LinearLayout id="progressPage" orientation="vertical" weight="1" spacing="10">

    <View weight="1" height="1"/>

    <!-- 进度条 + 实时动作：下面这行文字写清楚此刻是在复制文件还是执行命令 -->
    <ProgressBar id="bar" height="12" barHeight="12" radius="6"/>
    <TextView id="progressText" height="20" textColor="textMuted"/>

    <View weight="1" height="1"/>

    <!-- 进度页没有按钮：安装已经在跑，中途不给关闭，避免一边装一边关 -->
    <LinearLayout orientation="horizontal" height="32" marginTop="6">
      <View weight="1"/>
    </LinearLayout>
  </LinearLayout>

  <!-- ===== 第三页：完成 ===== -->
  <LinearLayout id="donePage" orientation="vertical" weight="1" spacing="10">

    <View weight="1" height="1"/>

    <!-- 「立即打开」：装完直接弹程序会打断用户，所以做成勾选项 -->
    <CheckBox id="runAfter" height="28" align="center">立即打开</CheckBox>

    <View weight="1" height="1"/>

    <!-- 完成按钮在正中间 -->
    <LinearLayout orientation="horizontal" height="34" marginTop="6">
      <View weight="1"/>
      <Button id="btnFinish" text="完成" style="primary" width="120" height="34"/>
      <View weight="1"/>
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
