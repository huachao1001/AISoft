<?xml version="1.0" encoding="utf-8"?>
<!--
  主窗口整体布局。

  纵向两段：

  - 主区（weight=1）：左侧缩略图侧栏 + 右侧看图区。看图区里再叠一层
    「图片 + 工具栏」，工具栏贴着图片下沿。
  - 底部状态栏：横跨整个窗口宽度，包括左侧缩略图列表底下那一段。

  状态栏占满整窗而不是跟着看图区：它报的是整窗的现状——当前图片的规格、
  当前缩放、左侧列表里选中的是第几张。这些东西跟左右分栏无关，一条完整的
  底线也比在侧栏边缘突然断掉更像「窗体的底边」。工具栏则相反，它只对当前
  图片动手，所以留在看图区里。

  侧栏可整体收缩，收起后宽度归零；展开/收起按钮在状态栏最左边，那个位置
  不随侧栏变化。

  标签名直接就是控件类名。PhotoView、ThumbnailStrip、SidePanel 都是 AiUI
  的通用控件，已登记在 layoutgen 的头文件表里，可以直接写。
-->
<LinearLayout id="mainColumn" orientation="vertical">

  <!--
    主区：横向两块。都是 height=match，把上面这一段填满。
  -->
  <LinearLayout id="mainRow" orientation="horizontal" weight="1" height="match">

    <!--
      侧栏：宽度写在 SidePanel 上，收缩动画改的也是它。
      ThumbnailStrip 跟着填满整列高度。
    -->
    <SidePanel id="sidePanel" width="208" height="match">

      <!-- 缩略图条：它只是导航，宽度跟着侧栏走 -->
      <ThumbnailStrip id="thumbs" width="match" height="match"/>

    </SidePanel>

    <!-- 右侧：看图区 + 工具栏，纵向两段 -->
    <LinearLayout id="viewColumn" orientation="vertical" weight="1" height="match">

      <!-- 看图区占满剩余高度，工具栏是固定高度 -->
      <FrameLayout id="stage" weight="1">

        <PhotoView id="photo" width="match" height="match"/>

        <!--
          首页：没有打开图片时盖住看图区。
          必须铺底色，否则下面的 PhotoView 会透上来（它的空状态也会画占位图标，
          两层图标叠在一起很难看）。
          上下各放一个弹性空白，把中间的列压到垂直中央——LinearLayout 的
          gravity 只管交叉轴（这里即水平），主轴要靠 weight 分配剩余空间。
        -->
        <LinearLayout id="homePane" orientation="vertical" width="match" height="match"
                      background="body" gravity="center">

          <View weight="1"/>

          <LinearLayout orientation="vertical" width="match" height="wrap" gravity="center">
            <!-- 图标颜色在 attachHome() 里按主题字段设，XML 的 tint 只认固定色 -->
            <ImageView id="homeIcon" icon="image" width="96" height="96"
                       scale="fit" align="center"/>

            <TextView id="homeTitle" text="拖拽图片到这里" height="34" marginTop="24"
                      textColor="text" align="center" large="true" bold="true"/>

            <TextView id="homeHint" text="也可以点下面的按钮，从磁盘里选一张"
                      height="24" marginTop="6" textColor="textMuted" align="center"/>

            <!-- 主按钮用 accent 底色：空状态页要有明确的主操作，不能整屏灰。
                 这里只放一个：另存为、缩放这些动作没有图就没有意义，
                 摆在空状态上只会是灰按钮。 -->
            <Button id="btnHomeOpen" text="打开图片..." style="primary" width="148" height="36"
                    marginTop="24"/>
          </LinearLayout>

          <View weight="1"/>
        </LinearLayout>

      </FrameLayout>

      <!-- 工具栏：八个按钮由 main_activity.cpp 在创建后装配，紧贴图片下沿 -->
      <ButtonBar id="toolBar" height="52"/>

    </LinearLayout>

  </LinearLayout>

  <!--
    状态栏行：横跨整窗。最左边是侧栏开关（入口固定在左下角，不管侧栏收没收
    都在同一处），右边是状态栏本体，它拿剩余宽度。
  -->
  <LinearLayout id="statusRow" orientation="horizontal" height="36" background="tool">

    <PanelToggle id="panelToggle" width="wrap" height="match"/>

    <StatusBar id="status" weight="1" height="match"/>

  </LinearLayout>

</LinearLayout>
